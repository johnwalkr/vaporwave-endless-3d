static float3 sky(float3 d, PU){
	float e=d.y;
	if(e<0.0) e = FULLSKY ? -d.y : 0.0;
	float3 c;
	const float midE=0.17;
	if(e<midE) c=mix(HOR,MIDC,e/midE);
	else { float t=(e-midE)/(1.0-midE); c=mix(MIDC,TOP,t*(2.0-t)); }
