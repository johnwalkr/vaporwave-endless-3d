	if(!FULLSKY){ float g=1.0-e*4.5; if(g>0.0) c+=GLOWC*(g*g*g*GLOWAMT); }
	if(SUNKIND<1.5 || SUNKIND>2.5){
		float dt=dot(d,SUNDIR);
		if(dt>SUNCOS){
			float R=SUNR;
			float rr=sqrt(max(2.0*(1.0-dt),0.0));
			float h=1.0-(rr-R)/(2.3*R);
			if(h>0.0){ h=min(h,1.0); c+=mix(SUNB,SUNT,0.4)*(h*h*(0.2+0.2*KICK)*GLOWAMT*3.0); }
			if(rr<R+PXANG){
				float v=(d.y-SUNDIR.y)/R;
				float a=sat((R-rr)/PXANG+0.5);
				if(SUNKIND<0.5 && v<0.3){
					float q=(0.3-v)/1.3;
					float ph=(v+2.0)*STRIPES*0.5+SCROLL;
					float fr=ph-floor(ph);
					float gap=0.1+0.62*q;
					float w=PXANG/R*STRIPES*0.5;
					a*=sat((fr-gap)/w+0.5)*sat((1.0-fr)/w+0.5);
				}
				float3 sc2=mix(SUNB,SUNT,sat(v*0.5+0.5))*1.2;
				c=mix(c,sc2,a);
			}
		}
	}
	if(MOONKIND>0.5){
		float dt=dot(d,MOONDIR);
		if(dt>0.98){
			float rr=sqrt(max(2.0*(1.0-dt),0.0));
			if(rr<MOONR+PXANG){
				float a=sat((MOONR-rr)/PXANG+0.5);
				if(MOONKIND<1.5){
					float d2=dot(d,MOON2);
					float r2=sqrt(max(2.0*(1.0-d2),0.0));
					a*=1.0-sat((MOONR*0.92-r2)/PXANG+0.5);
				}
				c=mix(c,mix(SUNT,float3(1.0),0.6)*1.15,a);
			}
		}
	}
	return c;
}

static float gridCov(float h,float invG,float G,float lh,float fp){
	float g=h*invG;
	float d=abs(g-floor(g+0.5))*G;
	float w=max(lh,0.6*fp);
	float cov=sat((w+0.5*fp-d)/fp);
	float k=sat(1.5-1.5*fp*invG);
	return cov*k+0.3*(1.0-k);
}

static float3 spaceFloor(float hx,float hz,float fpz, PU){
	float fade=1.0/(1.0+fpz*0.8);
	int ft=int(FLOORTYPE+0.5);
	if(ft==12){
		float z=hz+TIME*0.6;
		float n=sin(hx*0.045+sin(z*0.03+1.7)*2.2)*sin(z*0.05+sin(hx*0.035)*2.0);
		float n2=sin(hx*0.21+sin(z*0.17)*1.5)*sin(z*0.19+hx*0.05);
		return mix(TILE,FLOORC,sat(0.55+0.4*n+0.18*n2*fade));
	}
	if(ft==13){
		float n=sin(hx*0.31+sin(hz*0.23+PH2)*2.1)*sin(hz*0.27+PH3+sin(hx*0.19)*2.3);
		float g=sat(1.0-abs(n)*7.0); g*=g;
		float3 rock=mix(TILE,FLOORC,0.5+0.5*sin(hx*1.7+hz*1.3)*fade);
		return rock+float3(1.9,0.55,0.08)*(g*(0.8+0.6*KICK));
	}
	float n=sin(hx*0.37+sin(hz*0.29+PH1)*1.9)*sin(hz*0.41+PH2+sin(hx*0.23)*1.7);
	float n2=sin(hx*2.9+sin(hz*2.3+PH3)*1.3)*sin(hz*3.1+hx*0.7+PH2);
	return mix(TILE,FLOORC,sat(0.6+0.3*n+0.22*n2*fade));
}

static float3 floorC(float3 d, PU){
	float t=CAMP.y/-d.y;
	float fog=t*(1.0/FARD)*FOGMUL;
	if(fog>=1.0) return FOGC;
	fog*=fog;
	float hx=CAMP.x+d.x*t, hz=CAMP.z+d.z*t;
	float k=t/d.y;
	float tpx=-k*CAMR.y*INVF, tpy=k*CAMU.y*INVF;
	float fpx=abs(CAMR.x*INVF*t+d.x*tpx)+abs(-CAMU.x*INVF*t+d.x*tpy)+1e-6;
	float fpz=abs(CAMR.z*INVF*t+d.z*tpx)+abs(-CAMU.z*INVF*t+d.z*tpy)+1e-6;
	float inv=1.0/length(d);
	float ny=-d.y*inv;
	float G=GSZ, invG=1.0/G;
	int ft=int(FLOORTYPE+0.5);
	float3 c;
	float3 refl=float3(d.x*inv,ny,d.z*inv);
	if(ft>=11){
		c=spaceFloor(hx,hz,fpz,AU);
		if(GLOSS>0.0){ float f=1.0-ny; c+=sky(refl,AU)*(GLOSS*f*f); }
	} else if(ft==1){
		float ux=hx*invG*0.5, uz=hz*invG*0.5;
		float tx=abs(fract(ux)-0.5)*4.0-1.0;
		float tz=abs(fract(uz)-0.5)*4.0-1.0;
		float s=clamp(tx*G*0.5/fpx,-1.0,1.0)*clamp(tz*G*0.5/fpz,-1.0,1.0);
		c=mix(FLOORC,TILE*0.8,0.5+0.5*s);
		if(fpz<G){
			int ix=int(floor(hx*invG+0.5));
			int iz=int(floor(hz*invG+0.5))+int(UI.z);
			if((hashu(uint(ix),uint(iz),UI.y+UI.x)&31u)==0u)
				c+=ACC*(abs(s)*(1.0-HALFFRAC)*(1.0-fpz*invG)*0.9);
		}
		if(GLOSS>0.0){ float f=1.0-ny; c+=sky(refl,AU)*(GLOSS*(0.05+0.6*f*f)); }
	} else if(ft==2){
		float att=1.0/(1.0+fpz*1.2);
		float w1=sin(hx*0.9+hz*0.35+TIME*1.3+PH1);
		float w2=sin(hz*1.7-TIME*1.9+hx*0.2+PH2);
		float w3=sin((hx+hz)*2.3+TIME*2.4+PH3);
		float nx=(w1*0.04+w3*0.02)*att;
		float nz=(w2*0.06+w3*0.02)*att;
		float3 r=float3(d.x*inv+nx, max(ny+nz*0.6,0.004), d.z*inv+nz*0.3);
		float f=1.0-ny; f=0.3+0.7*f*f*f;
		c=FLOORC*0.55+sky(normalize(r),AU)*(f*GLOSS);
		float g=max(gridCov(hx,invG*0.25,G*4.0,LINEHALF,fpx), gridCov(hz,invG*0.25,G*4.0,LINEHALF,fpz));
		c+=LINEC*(g*0.3);
	} else {
		float gx=gridCov(hx,invG,G,LINEHALF,fpx);
		float gz=gridCov(hz,invG,G,LINEHALF,fpz);
		float boost=1.0+0.9*KICK;
		float wd=abs(hz-CAMP.z-WAVE)*(1.0/7.0);
		if(wd<1.0) boost+=(1.0-wd)*0.9;
		gz*=boost;
		gx=max(gx,gz);
		c=FLOORC+LINEC*(gx*1.45);
		if(GLOSS>0.0){ float f=1.0-ny; c+=sky(refl,AU)*(GLOSS*(0.12+0.88*f*f)); }
	}
	int nr=int(NRINGSF);
	for(int i=0;i<nr;i++){
		float4 r=U[RINGS+i];
		float amp=U[RAMP+i/4][i%4];
		float ex=hx-r.x, ez=hz-r.y;
		float u=(sqrt(ex*ex+ez*ez)-r.z)/r.w;
		if(u>-1.0 && u<1.0){ u=1.0-u*u; c+=mix(ACC,float3(1.0),0.4)*(u*u*amp*1.6); }
	}
	return mix(c,FOGC,fog);
}


// ---- full-screen triangle ----------------------------------------------------
struct FSOut { float4 pos [[position]]; };

vertex FSOut fsVS(uint vid [[vertex_id]]) {
	float2 q = float2(float((vid << 1) & 2), float(vid & 2));
	FSOut o; o.pos = float4(q * 2.0 - 1.0, 0.0, 1.0); return o;
}

// ---- 1. sky + floor -------------------------------------------------------------
fragment float4 bgFS(FSOut in [[stage_in]], constant float4* U [[buffer(0)]], constant uint4& UI [[buffer(1)]]) {
	float px = in.pos.x - 0.5, py = in.pos.y - 0.5;
	float a = (px - CX) * INVF, b = (CY - py) * INVF;
	float3 d = CAMF + CAMU * b + CAMR * a;
	float3 c;
	if (d.y >= 0.0 || FULLSKY) c = sky(normalize(d), AU); else c = floorC(d, AU);
	return float4(c, 1.0);
}

// ---- 2. geometry (anti-aliased by the CPU-computed edge distances) ------------
struct GeoIn {
	float3 pos [[attribute(0)]];
	float4 col [[attribute(1)]];
	float2 dh  [[attribute(2)]];
};
struct GeoOut { float4 pos [[position]]; float4 col; float2 dh; };

vertex GeoOut geoVS(GeoIn v [[stage_in]], constant float2& vp [[buffer(1)]]) {
	GeoOut o;
	o.pos = float4((v.pos.x + 0.5) / vp.x * 2.0 - 1.0, 1.0 - (v.pos.y + 0.5) / vp.y * 2.0, 1.0 - min(v.pos.z * 0.3, 1.0), 1.0);
	o.col = v.col; o.dh = v.dh;
	return o;
}

fragment float4 geoFS(GeoOut in [[stage_in]]) {
	float cov = clamp(in.dh.y + 0.5 - abs(in.dh.x), 0.0, 1.0);
	return float4(in.col.rgb * cov, in.col.a * cov);
}

// ---- 3. bloom: bright-pass 4x4 downsample, then separable box blurs ----------
fragment float4 downFS(FSOut in [[stage_in]], texture2d<float> src [[texture(0)]]) {
	int2 b = int2(in.pos.xy);
	int2 sz = int2(src.get_width(), src.get_height());
	float3 s = float3(0.0); int n = 0;
	for (int y = 0; y < 4; y++) for (int x = 0; x < 4; x++) {
		int2 q = b * 4 + int2(x, y);
		if (q.x < sz.x && q.y < sz.y) { s += max(src.read(uint2(q)).rgb - 0.62, float3(0.0)); n++; }
	}
	return float4(s / float(max(n, 1)), 1.0);
}

fragment float4 blurFS(FSOut in [[stage_in]], texture2d<float> src [[texture(0)]], constant int2& dirRad [[buffer(0)]]) {
	int2 q = int2(in.pos.xy);
	int2 sz = int2(src.get_width(), src.get_height());
	int2 dd = dirRad.x == 0 ? int2(1, 0) : int2(0, 1);
	int r = dirRad.y;
	float3 s = float3(0.0);
	for (int k = -r; k <= r; k++) s += src.read(uint2(clamp(q + dd * k, int2(0), sz - 1))).rgb;
	return float4(s / float(2 * r + 1), 1.0);
}

// ---- 4. composite: bloom, VHS effects, tone curve -----------------------------
struct CompP { float4 P[3]; uint4 F; };

static float tone(float x) {
	if (x <= 0.0) return 0.0;
	if (x > 0.75) x = 0.75 + 0.25 * (1.0 - 1.0 / (1.0 + (x - 0.75) * 4.0));
	return min(x, 1.0);
}

fragment float4 compFS(FSOut in [[stage_in]], texture2d<float> scene [[texture(0)]], texture2d<float> bloomT [[texture(1)]],
                       constant CompP& cp [[buffer(0)]]) {
	constexpr sampler lin(filter::linear, address::clamp_to_edge);
	int W = int(cp.P[1].x), H = int(cp.P[1].y);
	int x = int(in.pos.x), y = int(in.pos.y);
	uint frame = cp.F.x;
	float glitch = cp.P[0].y;
	int off = 0;
	if (glitch > 0.0) {
		uint band = hashu(uint(y / (6 + int(frame % 5u) * 3)), frame / 2u, 5u);
		if (float(band & 1023u) / 1023.0 < glitch * 0.8)
			off = int((float((band >> 10u) & 1023u) / 1023.0 - 0.5) * glitch * float(W) * 0.35);
	}
	int ca = int(cp.P[2].z) + int(glitch * 6.0);
	float sl = 1.0;
	if (y % 3 == 2) sl = 1.0 - 0.16 * cp.P[2].x;
	float tb = float((int(frame) * 2 + H - y) % (H * 2)) / float(H);
	if (tb < 0.06) sl *= 1.0 + 0.08 * cp.P[2].w;
	int sx = x + off;
	if (sx < 0) sx += W; else if (sx >= W) sx -= W;
	int xr = max(sx - ca, 0), xb = min(sx + ca, W - 1);
	float3 c = float3(scene.read(uint2(xr, y)).r, scene.read(uint2(sx, y)).g, scene.read(uint2(xb, y)).b);
	float2 buv = float2((float(sx) + 0.5) * 0.25, (float(y) + 0.5) * 0.25) / float2(bloomT.get_width(), bloomT.get_height());
	c += bloomT.sample(lin, buv).rgb * cp.P[0].x;
	float vx = float(x) / float(W) - 0.5, vy = float(y) / float(H) - 0.5;
	float v = (1.0 - 0.55 * (vx * vx + vy * vy)) * sl;
	uint rs = hashu(uint(x), uint(y), frame * 7u + 99u);
	float gr = (float(rs >> 24u) / 255.0 - 0.5) * (0.035 * cp.P[2].y + glitch * 0.25) + cp.P[0].z;
	c = c * v + gr;
	return float4(tone(c.r), tone(c.g), tone(c.b), 1.0);
}

// ---- 5. scale to the screen -----------------------------------------------------
fragment float4 blitFS(FSOut in [[stage_in]], texture2d<float> src [[texture(0)]], constant float4& P [[buffer(0)]]) {
	constexpr sampler lin(filter::linear, address::clamp_to_edge);
	return float4(src.sample(lin, in.pos.xy / P.xy).rgb, 1.0);
}
